OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=local-main
OLLAMA_CHAT_CONTEXT=16384
OLLAMA_TOOL_CONTEXT=12288
OLLAMA_PLANNER_CONTEXT=8192
OLLAMA_CHAT_MAX_TOKENS=1024
OLLAMA_TOOL_MAX_TOKENS=768
OLLAMA_PLANNER_MAX_TOKENS=384
FAMILY_NAME=Our Family
FAMILY_AI_DATA_DIR=*
# Required for production persistence (URL-encode special password characters):
# DATABASE_URL=*
CODEX_CLI_PATH=*
HF_HOME=*
VOICE_WAKE_WORD=*
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback
GMAIL_BACKUP_ROOT=*
TTS_MODEL_PATH=*
TTS_CHINESE_VOICE=*
TTS_ENGLISH_VOICE=*
# Family AI MCP listens on the LAN. Ollama and the database should remain private.
FAMILY_AI_MCP_HOST=0.0.0.0
FAMILY_AI_MCP_PORT=8001
FAMILY_AI_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,*,*
# Optional; defaults to FAMILY_AI_DATA_DIR/mcp-devices.json
# FAMILY_AI_MCP_DEVICES_FILE=*
