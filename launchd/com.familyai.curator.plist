<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.familyai.curator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>* Support/FamilyAI/bin/monthly-curator.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>* Support/FamilyAI/app</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>* Support/FamilyAI/logs/curator.log</string>
  <key>StandardErrorPath</key>
  <string>* Support/FamilyAI/logs/curator.error.log</string>
</dict>
</plist>
